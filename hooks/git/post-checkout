#!/bin/sh
# State pack post-checkout. On a branch checkout (flag 1), creates STATE-<branch-slug>.md in the
# memory store for a non-trunk branch if it is missing and lists it in the root STATE.md
# (state_manager.py new-branch). File checkouts, trunk branches, a detached HEAD, an unreachable
# store or a repo that is not migrated do nothing. Never blocks. Then runs the repo's own post-checkout.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
. "$HOOK_DIR/state-hook-lib.sh"
if [ "$3" = "1" ] && ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && state_ready; then
  run_py "$STATE_TOOLS/state_manager.py" new-branch --repo "$ROOT" 2>/dev/null
fi
chain_hook post-checkout "$@"
exit 0
