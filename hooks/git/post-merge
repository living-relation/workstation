#!/bin/sh
# State pack post-merge. Runs only when HEAD is the trunk (main, master, trunk, or the default branch
# named by origin/HEAD). After `git merge <branch>`, removes the merged branch's untracked TASK.md:
# in that branch's worktree and at this checkout's root. After any merge or pull into the trunk, warns
# when a top-level STATE-*.md (a branch's state file) is on the trunk: the PR should have archived the
# state file as its last commit (pr-closeout), and CI blocks such a PR. It never edits or commits a
# STATE file (no writes to the trunk). Never blocks. Then runs the repo's own post-merge.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
. "$HOOK_DIR/state-hook-lib.sh"

merged_branch() {
  subject=$(git reflog -1 --format=%gs 2>/dev/null)
  case "$subject" in
    "merge "*) ;;
    *) return 1 ;;
  esac
  name=${subject#merge }
  name=${name%%:*}
  for remote in $(git remote 2>/dev/null); do
    case "$name" in
      "$remote"/*) name=${name#"$remote"/} ;;
    esac
  done
  [ -n "$name" ] && printf '%s\n' "$name"
}

remove_task_file() {
  dir=$1
  [ -f "$dir/TASK.md" ] || return 0
  if git -C "$dir" ls-files --error-unmatch TASK.md >/dev/null 2>&1; then
    return 0
  fi
  rm -f "$dir/TASK.md" && echo "post-merge: removed $dir/TASK.md"
}

branch_worktree() {
  git worktree list --porcelain 2>/dev/null | awk -v want="branch refs/heads/$1" '
    /^worktree / { path = substr($0, 10) }
    $0 == want { print path; exit }'
}

on_trunk() {
  current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  case "$current" in
    main | master | trunk) return 0 ;;
  esac
  default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  [ -n "$default" ] && [ "$current" = "${default#origin/}" ]
}

warn_leftover_state() {
  for leftover in "$1"/STATE-*.md; do
    [ -f "$leftover" ] || continue
    echo "post-merge: $(basename "$leftover") is a branch state file on the trunk. Archive the state file in a PR (state_manager.py archive-branch --branch <branch>); CI blocks a PR that leaves one." >&2
  done
}

ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$ROOT" ] && on_trunk; then
  branch=$(merged_branch)
  if [ -n "$branch" ]; then
    worktree=$(branch_worktree "$branch")
    [ -n "$worktree" ] && remove_task_file "$worktree"
    remove_task_file "$ROOT"
  fi
  [ -f "$ROOT/STATE.md" ] && warn_leftover_state "$ROOT"
fi
chain_hook post-merge "$@"
exit 0
