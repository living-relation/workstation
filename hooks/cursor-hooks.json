{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CURSOR_PLUGIN_ROOT}/hooks/projects-root-guard.ps1\"",
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|Shell"
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CURSOR_PLUGIN_ROOT}/hooks/projects-root-report.ps1\"",
        "loop_limit": 1
      }
    ]
  }
}
